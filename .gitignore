# Build output (generated by the Docker build; never committed)
public/

# Obsidian settings are local only, never versioned. Everything in here was
# stock defaults anyway.
.obsidian/
.trash/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Editor cruft
.vscode/
.idea/
*.bak
*~

# Secrets
.env
.env.*

# Claude Code — personal/machine-local files only. Skills, agents,
# and commands under .claude/ are meant to be committed and shared,
# so don't ignore the whole folder.
.claude/settings.local.json
.claude/launch.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local/
.claude/first-run
.claude/assistant-daemon-state.json
